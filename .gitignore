# Environments
.venv/
.claude/

# Python caches
**/__pycache__/
*.py[cod]

# Secrets: never commit the Gurobi licence
gurobi.lic

# Simulation output is ignored by default; the handoff artefacts
# (trained policy, eval logs, charts) are re-included below.
*.csv
output/*
!output/sac/
output/sac/*
!output/sac/surrogate_policy.pt
!output/sac/episode_logs.jsonl
!output/sac/*.png
!output/comparison/
output/comparison/*
!output/comparison/eval_sac.jsonl
!output/comparison/eval_arbitrage.jsonl
!output/comparison/eval_optimisation.jsonl
!output/comparison/*.png

# Scenario data is committed. load_profile.csv (147 MB) is over GitHub's
# 100 MB limit, so it ships as load_profile.zip; unzip it in place.
!data/config/scenario_data/*.csv
data/config/scenario_data/load_profile.csv

docs/
